generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum EstadoPedido {
  pendiente
  enviado
  entregado
}

model Proveedor {
  id        Int        @id @default(autoincrement())
  nombre    String     @db.VarChar(100)
  telefono  String?    @db.VarChar(20)
  email     String     @db.VarChar(100)
  direccion String?    @db.VarChar(150)
  CUIL_CUIT String     @unique(map: "uq_proveedores_cuit") @db.VarChar(20)
  activo    Boolean    @default(true) // <-- Baja lógica agregada
  productos Producto[]

  @@map("proveedores")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  telefono  String?  @db.VarChar(20)
  email     String   @db.VarChar(100)
  direccion String?  @db.VarChar(150)
  CUIL_CUIT String   @unique(map: "uq_clientes_cuit") @db.VarChar(20)
  activo    Boolean  @default(true) // <-- Baja lógica agregada
  pedidos   Pedido[]

  @@map("clientes")
}

model Empleado {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(100)
  apellido String   @db.VarChar(100)
  cargo    String?  @db.VarChar(50)
  email    String   @unique(map: "uq_empleados_email") @db.VarChar(100)
  activo   Boolean  @default(true) // <-- Baja lógica agregada
  pedidos  Pedido[]

  @@map("empleados")
}

model CompaniaEnvio {
  id       Int      @id @default(autoincrement())
  nombre   String   @db.VarChar(100)
  telefono String?  @db.VarChar(20)
  pedidos  Pedido[]

  @@map("companias_envio")
}

model Producto {
  id           Int             @id @default(autoincrement())
  nombre       String          @db.VarChar(100)
  precio       Decimal         @db.Decimal(10, 2)
  stock        Int             @default(0)
  id_proveedor Int
  proveedor    Proveedor       @relation(fields: [id_proveedor], references: [id], onDelete: Restrict)
  detalles     DetallePedido[]

  @@map("productos")
}

model Pedido {
  id                Int             @id @default(autoincrement())
  fecha             DateTime        @db.Date
  estado            EstadoPedido    @default(pendiente)
  id_cliente        Int
  id_empleado       Int
  id_compania_envio Int
  cliente           Cliente         @relation(fields: [id_cliente], references: [id], onDelete: Restrict)
  empleado          Empleado        @relation(fields: [id_empleado], references: [id], onDelete: Restrict)
  compania_envio    CompaniaEnvio   @relation(fields: [id_compania_envio], references: [id], onDelete: Restrict)
  detalles          DetallePedido[]

  @@map("pedidos")
}

model DetallePedido {
  id_pedido       Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal  @db.Decimal(10, 2)
  pedido          Pedido   @relation(fields: [id_pedido], references: [id], onDelete: Cascade)
  producto        Producto @relation(fields: [id_producto], references: [id], onDelete: Restrict)

  @@id([id_pedido, id_producto])
  @@map("detalle_pedido")
}