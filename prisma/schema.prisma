generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Proveedor {
  id        Int    @id @default(autoincrement())
  nombre    String @db.VarChar(100)
  CUIL_CUIT String @unique @db.VarChar(20)
  @@map("proveedores")
}